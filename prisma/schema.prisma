generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  chart UserChart?

  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile UserProfile?

  conversations Conversation[]
  memory        UserMemory?
  memoryFacts   MemoryFact[]
}

model UserProfile {
  id String @id @default(uuid())

  userId String @unique

  fullName String?

  birthDate DateTime?

  birthTime String?

  birthTimeKnown Boolean @default(true)

  birthPlace String?

  locationId Int?

  location Location? @relation(fields: [locationId], references: [id])

  latitude  Float?
  longitude Float?
  timezone  String?

  primaryFocus   String?
  secondaryFocus String?

  pressureResponse String?
  misunderstoodFor String?

  entryReason String?

  entryQuestion String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id Int @id @default(autoincrement())

  name  String
  state String

  latitude  Float
  longitude Float

  population Int?

  timezone String

  searchName String

  createdAt DateTime @default(now())

  userProfiles UserProfile[]
}

model UserChart {
  id String @id @default(uuid())

  userId String @unique

  chartData Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id String @id @default(uuid())

  userId String

  title String

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Message {
  id String @id @default(uuid())

  conversationId String

  // "user" or "assistant"
  role String

  content String @db.Text

  // For assistant turns: intent, cited evidence and suggested remedies.
  meta Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Saarthi's running memory of the conversation: a short summary of what has
// been talked about, covering every message up to runningThrough. The latest
// messages are read verbatim instead (short-term memory).
model UserMemory {
  id String @id @default(uuid())

  userId String @unique

  running        String?   @db.Text
  runningThrough DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Long-term memory: lasting things the person has shared (people, work,
// events, patterns, what helps, goals). They can see and delete each one.
model MemoryFact {
  id String @id @default(uuid())

  userId String

  // people, work, life, event, pattern, helps, goal, preference
  category String

  text String @db.Text

  // For events: when it happens or happened (YYYY-MM-DD)
  eventDate String?

  // 1 = minor, 2 = useful, 3 = central to their story
  importance Int @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
